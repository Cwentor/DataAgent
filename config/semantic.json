  "metrics": [
    {
      "key": "gmv",
      "title": "GMV（商品交易总额）",
      "aliases": [
        "gmv",
        "销售额",
        "销售总额",
        "成交额",
        "成交金额",
        "总销售",
        "总销售额"
      ],
      "definition": "成功支付订单的实付金额之和；通常需限定支付状态为成功，并给定时间窗口。",
      "formula": "SUM(order_detail.split_total_amount)",
      "fields": [
        "split_total_amount",
        "order_status",
        "order_time"
      ],
      "shape": [
        {
          "kind": "aggregate",
          "field": "split_total_amount",
          "agg": "sum",
          "alias": "gmv"
        }
      ]
    },
    {
      "key": "order_count",
      "title": "订单数",
      "aliases": [
        "订单数",
        "订单量",
        "订单总数",
        "订单笔数"
      ],
      "definition": "订单主键的计数；若要求成功订单，需附加支付状态为成功的过滤条件。",
      "formula": "COUNT(DISTINCT order_detail.order_id)",
      "fields": [
        "order_id",
        "order_status",
        "order_time"
      ],
      "shape": [
        {
          "kind": "aggregate",
          "field": "order_id",
          "agg": "count_distinct",
          "alias": "order_count"
        }
      ]
    },
    {
      "key": "active_users",
      "title": "活跃用户数（去重用户数）",
      "aliases": [
        "去重用户",
        "活跃用户",
        "去重用户数",
        "活跃用户数"
      ],
      "definition": "在指定时间窗口内发生下单行为的去重用户数。注意：该口径不区分活跃度高低。",
      "formula": "COUNT(DISTINCT order_detail.user_id)",
      "fields": [
        "user_id",
        "order_time"
      ],
      "shape": [
        {
          "kind": "aggregate",
          "field": "user_id",
          "agg": "count_distinct",
          "alias": "active_users"
        }
      ]
    },
    {
      "key": "arpu",
      "title": "ARPU（人均消费）",
      "aliases": [
        "arpu",
        "人均消费"
      ],
      "definition": "总成交金额除以去重用户数，即平均每用户的消费金额。",
      "formula": "SUM(split_total_amount) / COUNT(DISTINCT user_id)",
      "fields": [
        "split_total_amount",
        "user_id"
      ],
      "shape": [
        {
          "kind": "ratio",
          "numerator": {
            "kind": "aggregate",
            "field": "split_total_amount",
            "agg": "sum",
            "alias": "gmv"
          },
          "denominator": {
            "kind": "aggregate",
            "field": "user_id",
            "agg": "count_distinct",
            "alias": "active_users"
          },
          "alias": "arpu"
        }
      ]
    },
    {
      "key": "refund_rate",
      "title": "退款率",
      "aliases": [
        "退款率"
      ],
      "definition": "退款金额占订单金额的比例，用于衡量订单退款强度。",
      "formula": "SUM(order_refund_info.refund_amount) / SUM(order_detail.split_total_amount)",
      "fields": [
        "refund_amount",
        "split_total_amount"
      ],
      "shape": [
        {
          "kind": "ratio",
          "numerator": {
            "kind": "aggregate",
            "field": "refund_amount",
            "agg": "sum",
            "alias": "refund_amount"
          },
          "denominator": {
            "kind": "aggregate",
            "field": "split_total_amount",
            "agg": "sum",
            "alias": "gmv"
          },
          "alias": "refund_rate"
        }
      ]
    },
    {
      "key": "refund_amount",
      "title": "退款金额",
      "aliases": [
        "退款金额",
        "退款总额",
        "退款额"
      ],
      "definition": "退款事实表中退款金额的求和。",
      "formula": "SUM(order_refund_info.refund_amount)",
      "fields": [
        "refund_amount"
      ],
      "shape": [
        {
          "kind": "aggregate",
          "field": "refund_amount",
          "agg": "sum",
          "alias": "refund_amount"
        }
      ]
    },
    {
      "key": "avg_order_amount",
      "title": "客单价",
      "aliases": [
        "客单价"
      ],
      "definition": "平均每笔订单的实付金额。",
      "formula": "SUM(order_detail.split_total_amount) / COUNT(DISTINCT order_detail.order_id)",
      "fields": [
        "split_total_amount",
        "order_id"
      ],
      "shape": [
        {
          "kind": "aggregate",
          "field": "split_total_amount",
          "agg": "sum",
          "alias": "gmv"
        },
        {
          "kind": "aggregate",
          "field": "order_id",
          "agg": "count_distinct",
          "alias": "orders"
        },
        {
          "kind": "expression",
          "alias": "aov",
          "expr": {
            "op": "div",
            "args": [
              {
                "ref": "gmv"
              },
              {
                "ref": "orders"
              }
            ]
          }
        }
      ]
    }
  ],
