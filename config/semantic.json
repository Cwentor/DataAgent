{
  "fact_table": "fact_orders",
  "fact_tables": ["fact_orders", "fact_refunds"],
  "aliases": {
    "fact_orders": "f",
    "fact_refunds": "r",
    "dim_user": "u",
    "dim_product": "p",
    "dim_shop": "s"
  },
  "fields": {
    "order_id": { "table": "fact_orders", "column": "order_id", "dtype": "int", "label": "订单ID" },
    "user_id": { "table": "fact_orders", "column": "user_id", "dtype": "int", "label": "用户ID" },
    "product_id": { "table": "fact_orders", "column": "product_id", "dtype": "int", "label": "商品ID" },
    "order_amount": { "table": "fact_orders", "column": "order_amount", "dtype": "float", "label": "订单金额" },
    "discount_amount": { "table": "fact_orders", "column": "discount_amount", "dtype": "float", "label": "优惠金额" },
    "pay_status": { "table": "fact_orders", "column": "pay_status", "dtype": "str", "label": "支付状态" },
    "order_time": { "table": "fact_orders", "column": "order_time", "dtype": "timestamp", "label": "下单时间" },
    "refund_id": { "table": "fact_refunds", "column": "refund_id", "dtype": "int", "label": "退款单ID" },
    "refund_amount": { "table": "fact_refunds", "column": "refund_amount", "dtype": "float", "label": "退款金额" },
    "refund_time": { "table": "fact_refunds", "column": "refund_time", "dtype": "timestamp", "label": "退款时间" },
    "refund_status": { "table": "fact_refunds", "column": "refund_status", "dtype": "str", "label": "退款状态" },
    "province": { "table": "dim_user", "column": "province", "dtype": "str", "label": "省份" },
    "gender": { "table": "dim_user", "column": "gender", "dtype": "str", "label": "性别" },
    "register_time": { "table": "dim_user", "column": "register_time", "dtype": "timestamp", "label": "注册时间" },
    "category": { "table": "dim_product", "column": "category", "dtype": "str", "label": "品类" },
    "brand": { "table": "dim_product", "column": "brand", "dtype": "str", "label": "品牌" },
    "unit_price": { "table": "dim_product", "column": "unit_price", "dtype": "float", "label": "单价" },
    "product_name": { "table": "dim_product", "column": "product_name", "dtype": "str", "label": "商品名称" },
    "shop_id": { "table": "fact_orders", "column": "shop_id", "dtype": "int", "label": "门店ID" },
    "shop_name": { "table": "dim_shop", "column": "shop_name", "dtype": "str", "label": "门店名称" }
  },
  "join_rules": {
    "dim_user": { "type": "inner", "on": [["user_id", "user_id"]] },
    "dim_product": { "type": "inner", "on": [["product_id", "product_id"]] },
    "dim_shop": { "type": "inner", "on": [["shop_id", "shop_id"]] }
  },
  "fact_join_rules": {
    "fact_refunds": { "type": "left", "on": [["order_id", "order_id"]] }
  }
}
