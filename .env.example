# LLM 接入配置（Agent 自动读取；未配置则回退到确定性启发式 NL2DSL）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# 审计与结构化日志（P0）
AUDIT_ENABLED=1
LOG_LEVEL=INFO

# SQL 执行层资源治理（P0/P1）
# 语句超时（毫秒）：超过则中断取消查询
QUERY_TIMEOUT_MS=30000
# 扫描行数上限：任一基表扫描超过即熔断拒绝执行
MAX_SCAN_ROWS=10000000
# 返回行数硬上限（LIMIT 硬上限熔断）
MAX_RESULT_ROWS=20000
# SQL 执行自愈最大重试次数（把精确引擎报错喂回 LLM 重写 DSL，至少 1 次）
SQL_SELF_HEAL_MAX_RETRIES=1
# 澄清槽位上下文 TTL（秒）：用户回答"最近30天"等短语的合并窗口（P0-5）
CLARIFY_SLOT_TTL=1800

# --------------------------------------------------------------------------- #
# 统一身份认证（P0）—— 见 auth/ 包
# --------------------------------------------------------------------------- #
# 是否启用 HTTP 鉴权（1 启用；0 关闭，关闭时回退 AUTH_DEFAULT_* 服务端默认身份，
# 客户端仍无法指定 principal）
AUTH_ENABLED=1
# 严格生产安全模式（P0-3）：=1 或绑定非 localhost 地址时，启动即拒绝弱默认
# JWT 密钥、拒绝 AUTH_ENABLED=0
AUTH_STRICT=0
# Web 服务绑定地址（生产部署可改为 0.0.0.0；非 localhost 自动进入严格模式）
WEB_HOST=127.0.0.1
# 鉴权关闭时的服务端默认身份（principal 由服务端决定）
AUTH_DEFAULT_PRINCIPAL=admin
AUTH_DEFAULT_USER=local-dev
AUTH_DEFAULT_DISPLAY=本地开发者
# JWT 密钥（生产环境务必替换为强随机密钥，如 python -c "import secrets;print(secrets.token_hex(32))"）
# 严格模式下使用弱默认值会拒绝启动
AUTH_JWT_SECRET=dev-insecure-jwt-secret-change-me
# 登录失败限流（P0-4）：按 用户名+IP 维度指数退避
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_BASE_SECONDS=2
AUTH_LOGIN_MAX_SECONDS=300
AUTH_JWT_ISSUER=dataagent
AUTH_JWT_AUDIENCE=dataagent-web
# 令牌有效期（秒）
AUTH_JWT_TTL=3600
AUTH_SESSION_TTL=86400
# 会话共享存储（P0-4）：配置为 SQLite 路径后会话落盘（重启不丢、多 worker 可共享）；
# 留空则使用进程内存储（本地开发/演示）
AUTH_SESSION_DB=
