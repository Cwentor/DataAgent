# LLM 接入配置（Agent 自动读取；未配置则回退到确定性启发式 NL2DSL）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# 审计与结构化日志（P0）
AUDIT_ENABLED=1
LOG_LEVEL=INFO

# SQL 执行层资源治理（P0/P1）
# 语句超时（毫秒）：超过则中断取消查询
QUERY_TIMEOUT_MS=30000
# 扫描行数上限：任一基表扫描超过即熔断拒绝执行
MAX_SCAN_ROWS=10000000
# 返回行数硬上限（LIMIT 硬上限熔断）
MAX_RESULT_ROWS=20000
# SQL 执行自愈最大重试次数（把精确引擎报错喂回 LLM 重写 DSL；默认 3）
SQL_SELF_HEAL_MAX_RETRIES=3
# 澄清槽位上下文 TTL（秒）：用户回答"最近30天"等短语的合并窗口（P0-5）
CLARIFY_SLOT_TTL=1800

# --------------------------------------------------------------------------- #
# 编排与 Agent（core/orchestrator）
# --------------------------------------------------------------------------- #
# 自主性分级默认档：L1 每步确认 / L2 计划确认 / L3 高危确认 / L4 全自动（前端可按会话覆盖）
AGENT_DEFAULT_AUTONOMY=L2
# LangGraph 迭代上限（防失控护栏）
ORCHESTRATOR_RECURSION_LIMIT=64
# checkpointer SQLite 落盘路径（HITL 挂起态重启不丢、多进程共享；留空则内存态，仅本地开发/演示）
ORCHESTRATOR_CHECKPOINT_DB=
# Subagent fan-out 并发上限与失败重派次数
SUBAGENT_MAX_PARALLEL=4
SUBAGENT_REDISPATCH_MAX=1
# 单轮工具链路最大步数 / 反思层结果充分性自检开关
MAX_AGENT_STEPS=5
AGENT_REFLECTION_ENABLED=1

# --------------------------------------------------------------------------- #
# 沙箱代码解释器（core/sandbox）：执行后端选择
# --------------------------------------------------------------------------- #
# subprocess（默认）= 恒用子进程，零部署；auto = Docker 优先探测（结果进程级
# 缓存），不可用回退子进程；docker = 显式要求容器强隔离，不可用时如实降级并留日志
SANDBOX_BACKEND=subprocess

# --------------------------------------------------------------------------- #
# 意图路由（agent/router）：五分类判决的 LLM 语义分类参数
# --------------------------------------------------------------------------- #
# LLM 分类置信阈值（低于则走规则兜底）
ROUTER_MIN_CONFIDENCE=0.6
ROUTER_LLM_TIMEOUT=15
# 意图路由专用模型（留空则复用 LLM_MODEL）
ROUTER_LLM_MODEL=

# --------------------------------------------------------------------------- #
# 资源与缓存
# --------------------------------------------------------------------------- #
# DuckDB 只读连接池容量 / 全局并发查询闸
DB_POOL_SIZE=4
MAX_CONCURRENT_QUERIES=4
# 查询结果缓存（按主体隔离防跨主体泄漏；默认关闭）
QUERY_CACHE_ENABLED=0
QUERY_CACHE_TTL_SECONDS=300
QUERY_CACHE_MAX_ENTRIES=256

# --------------------------------------------------------------------------- #
# 跨进程状态外置（persistence/）：Session / 澄清槽位 / 登录限流共用 SQLite KV，
# 配置后多 worker 状态一致；留空则进程内存储
# --------------------------------------------------------------------------- #
STATE_STORE_DB=

# --------------------------------------------------------------------------- #
# 模型供应商网关（providers/）：Key 落盘加密主密钥（缺省回退 AUTH_JWT_SECRET）
# --------------------------------------------------------------------------- #
PROVIDERS_ENC_SECRET=
PROVIDER_TIMEOUT=60

# --------------------------------------------------------------------------- #
# 统一身份认证（P0）—— 见 auth/ 包
# --------------------------------------------------------------------------- #
# 是否启用 HTTP 鉴权（1 启用；0 关闭，关闭时回退 AUTH_DEFAULT_* 服务端默认身份，
# 客户端仍无法指定 principal）
AUTH_ENABLED=1
# 严格生产安全模式（P0-3）：=1 或绑定非 localhost 地址时，启动即拒绝弱默认
# JWT 密钥、拒绝 AUTH_ENABLED=0
AUTH_STRICT=0
# Web 服务绑定地址（生产部署可改为 0.0.0.0；非 localhost 自动进入严格模式）
WEB_HOST=127.0.0.1
# 鉴权关闭时的服务端默认身份（principal 由服务端决定）
AUTH_DEFAULT_PRINCIPAL=admin
AUTH_DEFAULT_USER=local-dev
AUTH_DEFAULT_DISPLAY=本地开发者
# JWT 密钥（生产环境务必替换为强随机密钥，如 python -c "import secrets;print(secrets.token_hex(32))"）
# 严格模式下使用弱默认值会拒绝启动
AUTH_JWT_SECRET=dev-insecure-jwt-secret-change-me
# 登录失败限流（P0-4）：按 用户名+IP 维度指数退避
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_BASE_SECONDS=2
AUTH_LOGIN_MAX_SECONDS=300
AUTH_JWT_ISSUER=dataagent
AUTH_JWT_AUDIENCE=dataagent-web
# 令牌有效期（秒）
AUTH_JWT_TTL=3600
AUTH_SESSION_TTL=86400
# 会话共享存储（P0-4）：配置为 SQLite 路径后会话落盘（重启不丢、多 worker 可共享）；
# 留空则使用进程内存储（本地开发/演示）
AUTH_SESSION_DB=
