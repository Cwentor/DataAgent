# --------------------------------------------------------------------------- #
# 路径与数据锚点
# --------------------------------------------------------------------------- #
# 数仓路径（DuckDB 文件；默认 analytics_sandbox.duckdb）
DB_PATH=analytics_sandbox.duckdb
# 查询执行后端（二十五期五值）：duckdb | mysql | postgres | clickhouse | hive；
# 非 duckdb 时需配置下方对应连接组
DB_BACKEND=duckdb
# SQL 方言（编译器渲染目标）：留空跟随 DB_BACKEND；可独立覆盖（测试/排查用）
SQL_DIALECT=
# MySQL 执行后端连接（DB_BACKEND=mysql 时生效）
# 查询运行时用只读账号（部署要求：GRANT SELECT ON <db>.*，禁 File/Process/Super）；
# 建仓 python -m mock.init_mysql 复用本组配置但要求 CREATE/INSERT 权限
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=dataagent_ro
MYSQL_PASSWORD=
MYSQL_DATABASE=gmall
# PostgreSQL 执行后端连接（DB_BACKEND=postgres 时生效）
# 运行时只读账号需 GRANT SELECT ON ALL TABLES IN SCHEMA public；
# 建仓 python -m mock.init_postgres 复用本组配置但要求 CREATE/INSERT/DROP 权限
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=dataagent_ro
POSTGRES_PASSWORD=
POSTGRES_DATABASE=gmall
# 语义目录读取物理列所用的 schema（二十四期）；与建仓口径一致，默认 public
POSTGRES_SCHEMA=public
# ---------- ClickHouse 执行后端（二十三期，DB_BACKEND=clickhouse 时生效） ----------
# 运行时账号须为 readonly profile（readonly=1 + 预算两项，见 docs/designs/
# 2026-10-26-clickhouse-backend-design.md §9）；建仓复用本组但要求可写账号
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=dataagent_ro
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=gmall
# ---------- Hive 执行后端（二十五期，DB_BACKEND=hive 时生效） ----------
# 走 HiveServer2 HTTP transport（spec D2）；运行时账号仅 GRANT SELECT（SQL 标准
# 授权）；建仓 python -m mock.init_hive 复用本组但要求 CREATE/INSERT/DROP 权限
HIVE_HOST=127.0.0.1
HIVE_PORT=10000
HIVE_USER=dataagent_ro
HIVE_PASSWORD=
HIVE_DATABASE=gmall
# 建仓 staging（spec D10）：client=本机生成 CSV 目录（默认 <项目根>/build/hive_staging）；
# server=hiveserver2 进程可见路径（CI/docker 中两目录经卷映射为同一内容）
HIVE_STAGING_CLIENT_DIR=
HIVE_STAGING_SERVER_DIR=/opt/dataagent_staging
# 沙箱工作区根目录（ParquetRef 物化 + 沙箱 workspace 受限 open；默认 logs/workspaces）
WORKSPACE_ROOT=logs/workspaces
# 评测与时间锚点（AS_OF_DATE = 数据域锚定日期；DATA_DOMAIN_END = 时间域守卫上界）
AS_OF_DATE=2025-12-31
DATA_DOMAIN_END=2025-12-31
# 埋点日志目录（Gmall 埋点 JSON 日志落盘路径，运行时自动创建）
APPLOG_DIR=logs/gmall_applog

# --------------------------------------------------------------------------- #
# LLM 接入配置（Agent 自动读取；未配置则回退到确定性启发式 NL2DSL）
# --------------------------------------------------------------------------- #
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# --------------------------------------------------------------------------- #
# 审计与结构化日志（P0/P3）
# --------------------------------------------------------------------------- #
AUDIT_ENABLED=1
LOG_LEVEL=INFO
# 结构化日志可选落盘文件（配置路径后启用 RotatingFileHandler 轮转落盘；留空则仅输出到 stderr）
AUDIT_LOG_FILE=

# --------------------------------------------------------------------------- #
# LLM 流式握手期安全重试（P4）
# --------------------------------------------------------------------------- #
# 握手期独立预算与重试（在首字节到达前的专用超时与重试上限）
PROVIDER_HANDSHAKE_TIMEOUT=30
PROVIDER_HANDSHAKE_RETRY_MAX=1
# 流式调用整体最大时长（秒）
PROVIDER_STREAM_MAX_SECONDS=300

# --------------------------------------------------------------------------- #
# 综合报告合成超时（秒）
# --------------------------------------------------------------------------- #
SYNTHESIZER_TIMEOUT=180

# SQL 执行层资源治理（P0/P1）
# 语句超时（毫秒）：超过则中断取消查询
QUERY_TIMEOUT_MS=30000
# 扫描行数上限：任一基表扫描超过即熔断拒绝执行
MAX_SCAN_ROWS=10000000
# 返回行数硬上限（LIMIT 硬上限熔断）
MAX_RESULT_ROWS=20000
# SQL 执行自愈最大重试次数（把精确引擎报错喂回 LLM 重写 DSL；默认 3）
SQL_SELF_HEAL_MAX_RETRIES=3
# 扫描行预检缓存容量上限（同一 SQL 自愈重试不重复 EXPLAIN ANALYZE 降本；超出清空）
MAX_SCAN_CACHE_SIZE=512
# 扫描行预检缓存 TTL（秒，0 = 永不过期）。缓存的是「这条 SQL 当时扫了多少行」，
# 数据增长后该值偏小会让 MAX_SCAN_ROWS 熔断静默失效，故须定期过期（审计 §9.1）。
# 批量导入数据后还应调用 exec.guards.clear_scan_cache() 立即失效。
SCAN_CACHE_TTL_SECONDS=300
# 澄清槽位上下文 TTL（秒）：用户回答"最近30天"等短语的合并窗口（P0-5）
CLARIFY_SLOT_TTL=1800

# --------------------------------------------------------------------------- #
# 编排与 Agent（core/orchestrator）
# --------------------------------------------------------------------------- #
# 自主性分级默认档：L1 每步确认 / L2 计划确认 / L3 高危确认 / L4 全自动（前端可按会话覆盖）
AGENT_DEFAULT_AUTONOMY=L2
# LangGraph 迭代上限（防失控护栏）
ORCHESTRATOR_RECURSION_LIMIT=64
# checkpointer SQLite 落盘路径（HITL 挂起态重启不丢、多进程共享；留空则内存态，仅本地开发/演示）
ORCHESTRATOR_CHECKPOINT_DB=
# Subagent fan-out 并发上限与失败重派次数
SUBAGENT_MAX_PARALLEL=4
SUBAGENT_REDISPATCH_MAX=1
# 单轮工具链路最大步数 / 反思层结果充分性自检开关
MAX_AGENT_STEPS=5
AGENT_REFLECTION_ENABLED=1

# 长任务 run（web/runs.py）：SSE 流式执行的保留与回收策略
# 单进程最多保留的 run 数（超出按最旧回收）
AGENT_RUN_MAX_RUNS=200
# 单个 run 的事件缓冲上限（超出丢弃最旧，防内存膨胀）
AGENT_RUN_MAX_EVENTS=5000
# run 空闲超时 / 保留 TTL / SSE 心跳间隔（秒）
AGENT_RUN_IDLE_TIMEOUT_SECONDS=300
AGENT_RUN_TTL_SECONDS=3600
AGENT_RUN_KEEPALIVE_SECONDS=15

# 异步任务池（web/tasks.py）
# 工作线程上限 / 历史保留条数 / 结果 TTL（秒）
ASYNC_TASK_MAX_WORKERS=2
ASYNC_TASK_HISTORY=1000
ASYNC_TASK_TTL_SECONDS=3600

# 会话上下文记忆（agent/memory.py）
# 保留轮数 / 最大会话数（LRU 淘汰）/ 会话 TTL（秒）
SESSION_MEMORY_HISTORY_TURNS=5
SESSION_MEMORY_MAX_SESSIONS=1000
SESSION_MEMORY_TTL=1800

# --------------------------------------------------------------------------- #
# 沙箱代码解释器（core/sandbox）：执行后端选择
# --------------------------------------------------------------------------- #
# subprocess（默认）= 恒用子进程，零部署；auto = Docker 优先探测（结果进程级
# 缓存），不可用回退子进程；docker = 显式要求容器强隔离，不可用时如实降级并留日志
SANDBOX_BACKEND=subprocess

# --------------------------------------------------------------------------- #
# 意图路由（agent/router）：五分类判决的 LLM 语义分类参数
# --------------------------------------------------------------------------- #
# LLM 分类置信阈值（低于则走规则兜底）
ROUTER_MIN_CONFIDENCE=0.6
ROUTER_LLM_TIMEOUT=15
# 意图路由专用模型（留空则复用 LLM_MODEL）
ROUTER_LLM_MODEL=

# --------------------------------------------------------------------------- #
# 资源与缓存
# --------------------------------------------------------------------------- #
# DuckDB 只读连接池容量 / 全局并发查询闸
DB_POOL_SIZE=4
MAX_CONCURRENT_QUERIES=4
# 查询结果缓存（按主体隔离防跨主体泄漏；默认关闭）
QUERY_CACHE_ENABLED=0
QUERY_CACHE_TTL_SECONDS=300
QUERY_CACHE_MAX_ENTRIES=256

# --------------------------------------------------------------------------- #
# 跨进程状态外置（persistence/）：Session / 澄清槽位 / 登录限流共用 SQLite KV，
# 配置后多 worker 状态一致；留空则进程内存储
# --------------------------------------------------------------------------- #
STATE_STORE_DB=

# --------------------------------------------------------------------------- #
# 模型供应商网关（providers/）：Key 落盘加密主密钥（缺省回退 AUTH_JWT_SECRET）
# --------------------------------------------------------------------------- #
PROVIDERS_ENC_SECRET=
PROVIDER_TIMEOUT=60

# --------------------------------------------------------------------------- #
# 统一身份认证（P0）—— 见 auth/ 包
# --------------------------------------------------------------------------- #
# 是否启用 HTTP 鉴权（1 启用；0 关闭，关闭时回退 AUTH_DEFAULT_* 服务端默认身份，
# 客户端仍无法指定 principal）
AUTH_ENABLED=1
# 严格生产安全模式（P0-3）：=1 或绑定非 localhost 地址时，启动即拒绝弱默认
# JWT 密钥、拒绝 AUTH_ENABLED=0
AUTH_STRICT=0
# Web 服务绑定地址（生产部署可改为 0.0.0.0；非 localhost 自动进入严格模式）
WEB_HOST=127.0.0.1
# 鉴权关闭时的服务端默认身份（principal 由服务端决定）
AUTH_DEFAULT_PRINCIPAL=admin
AUTH_DEFAULT_USER=local-dev
AUTH_DEFAULT_DISPLAY=本地开发者
# JWT 密钥（生产环境务必替换为强随机密钥，如 python -c "import secrets;print(secrets.token_hex(32))"）
# 严格模式下使用弱默认值会拒绝启动
AUTH_JWT_SECRET=dev-insecure-jwt-secret-change-me
# 登录失败限流（P0-4）：按 用户名+IP 维度指数退避
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_BASE_SECONDS=2
AUTH_LOGIN_MAX_SECONDS=300
AUTH_JWT_ISSUER=dataagent
AUTH_JWT_AUDIENCE=dataagent-web
# 令牌有效期（秒）
AUTH_JWT_TTL=3600
AUTH_SESSION_TTL=86400
# 会话共享存储（P0-4）：配置为 SQLite 路径后会话落盘（重启不丢、多 worker 可共享）；
# 留空则使用进程内存储（本地开发/演示）
AUTH_SESSION_DB=
